{
  "name": "allbeingsfuture",
  "version": "1.5.1",
  "private": true,
  "description": "AllBeingsFuture - AI Workbench (Electron + React)",
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:renderer\"",
    "dev:renderer": "cd frontend && npm run dev",
    "dev:electron": "tsc -p electron/tsconfig.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "cd frontend && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/minify-electron.mjs",
    "test:backend": "tsc -p electron/tsconfig.tests.json && node --test .task/allbeingsfuture-backend-tests/tests/acp-adapter.test.js .task/allbeingsfuture-backend-tests/tests/acp-builtin-smoke.test.js .task/allbeingsfuture-backend-tests/tests/acp-package-resolve.test.js .task/allbeingsfuture-backend-tests/tests/cli-path-resolve.test.js .task/allbeingsfuture-backend-tests/tests/agent-async-spawn.test.js .task/allbeingsfuture-backend-tests/tests/agent-stream-normalizer.test.js .task/allbeingsfuture-backend-tests/tests/bot-removal.test.js .task/allbeingsfuture-backend-tests/tests/capabilities-no-builtins.test.js .task/allbeingsfuture-backend-tests/tests/child-lifecycle-fixes.test.js .task/allbeingsfuture-backend-tests/tests/concurrency-guard.test.js .task/allbeingsfuture-backend-tests/tests/mempalace-safe.test.js .task/allbeingsfuture-backend-tests/tests/provider-defaults.test.js .task/allbeingsfuture-backend-tests/tests/provider-migration.test.js .task/allbeingsfuture-backend-tests/tests/session-mcp-policy.test.js .task/allbeingsfuture-backend-tests/tests/session-reconcile.test.js .task/allbeingsfuture-backend-tests/tests/session-cascade-delete.test.js .task/allbeingsfuture-backend-tests/tests/security-gates.test.js .task/allbeingsfuture-backend-tests/tests/supervisor-prompt-inject.test.js",
    "pack": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && npm run pack:mac:arm64 && npm run pack:mac:x64",
    "pack:mac:arm64": "PYTHON_PATH=/usr/bin/python3 electron-builder --mac --arm64",
    "pack:mac:x64": "PYTHON_PATH=/usr/bin/python3 electron-builder --mac --x64",
    "postinstall": "cd frontend && npm install"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.63.0",
    "@agentclientprotocol/codex-acp": "^1.1.7",
    "@agentclientprotocol/sdk": "1.3.0",
    "electron-store": "^10.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.allbeingsfuture.app",
    "productName": "AllBeingsFuture",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "electron/preload.cjs",
      "!**/node_modules/@openai/codex-*/**",
      "!**/node_modules/@openai/codex/vendor/**",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk/vendor/**",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk/cli.js",
      "!**/node_modules/@img/sharp-*/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "appicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "appicon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "AllBeingsFuture",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/@agentclientprotocol/claude-agent-acp/**/*",
      "node_modules/@agentclientprotocol/codex-acp/**/*",
      "node_modules/@agentclientprotocol/sdk/**/*",
      "node_modules/zod/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "electron/embedded-assets/mcps/agent-control",
        "to": "mcps/agent-control"
      },
      {
        "from": "electron/embedded-assets/mcps/mempalace-safe",
        "to": "mcps/mempalace-safe"
      },
      {
        "from": "resources/prompts",
        "to": "resources/prompts"
      },
      {
        "from": "appicon.ico",
        "to": "appicon.ico"
      },
      {
        "from": "appicon.icns",
        "to": "appicon.icns"
      }
    ]
  }
}
