{
  "name": "allbeingsfuture",
  "version": "1.5.0",
  "private": true,
  "description": "AllBeingsFuture - AI Workbench (Electron + React)",
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:renderer\"",
    "dev:renderer": "cd frontend && npm run dev",
    "dev:electron": "tsc -p electron/tsconfig.json && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "cd frontend && npm run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "test:backend": "tsc -p electron/tsconfig.tests.json && node --test .task/allbeingsfuture-backend-tests/tests/acp-adapter.test.js .task/allbeingsfuture-backend-tests/tests/acp-builtin-smoke.test.js .task/allbeingsfuture-backend-tests/tests/acp-package-resolve.test.js .task/allbeingsfuture-backend-tests/tests/agent-stream-normalizer.test.js .task/allbeingsfuture-backend-tests/tests/bot-removal.test.js .task/allbeingsfuture-backend-tests/tests/capabilities-no-builtins.test.js .task/allbeingsfuture-backend-tests/tests/concurrency-guard.test.js .task/allbeingsfuture-backend-tests/tests/provider-defaults.test.js .task/allbeingsfuture-backend-tests/tests/provider-migration.test.js .task/allbeingsfuture-backend-tests/tests/session-reconcile.test.js .task/allbeingsfuture-backend-tests/tests/supervisor-prompt-inject.test.js",
    "pack": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "postinstall": "cd frontend && npm install"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.63.0",
    "@agentclientprotocol/codex-acp": "^1.1.7",
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.62",
    "claude": "^0.1.1",
    "electron-store": "^10.0.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "sharp": "^0.34.5",
    "uuid": "^11.1.0",
    "yauzl": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/uuid": "^10.0.0",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.allbeingsfuture.app",
    "productName": "AllBeingsFuture",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "electron/preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "appicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "appicon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "AllBeingsFuture",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**/*",
      "node_modules/@agentclientprotocol/claude-agent-acp/**/*",
      "node_modules/@agentclientprotocol/codex-acp/**/*",
      "node_modules/@agentclientprotocol/sdk/**/*",
      "node_modules/@openai/codex/**/*",
      "node_modules/@openai/codex-*/**/*",
      "node_modules/zod/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "electron/embedded-assets/mcps/agent-control",
        "to": "mcps/agent-control"
      },
      {
        "from": "resources/prompts",
        "to": "resources/prompts"
      },
      {
        "from": "appicon.ico",
        "to": "appicon.ico"
      },
      {
        "from": "appicon.icns",
        "to": "appicon.icns"
      }
    ]
  }
}
